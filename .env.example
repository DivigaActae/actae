# Actae Configuration
# Copy this file to .env and customize:
#
#   cp .env.example .env
#
# The recommended local/development flow is the SAME as production:
#
#   cargo run -- --embedded
#
# which spawns an embedded PostgreSQL (see ACTAE_DATA_DIR /
# ACTAE_EMBEDDED_PG_* below) and serves the API + dashboard on
# http://127.0.0.1:8002. To use an EXTERNAL PostgreSQL instead, set
# POSTGRES_* / CLIENT_POSTGRES_* (or DATABASE_URL) — those always win over
# --embedded.

# Server
# Default bind: 127.0.0.1 (loopback) when TLS is off, 0.0.0.0 when TLS is
# on. ACTAE_HOST overrides.
ACTAE_HOST=127.0.0.1
ACTAE_PORT=8002            # Single port for API + Dashboard + WebSocket + Health/Metrics

# Logging. Release (compiled) binaries default to LOG_FORMAT=compact and hide
# the internal startup chatter until "Actae is fully operational"; debug builds
# (cargo run) default to verbose LOG_FORMAT=json. Setting either var explicitly
# (as here) overrides the build default and disables the startup gate.
LOG_LEVEL=info
LOG_FORMAT=json

# Authentication
JWT_SECRET=dev-jwt-secret-must-be-at-least-32-chars!!   # PRODUCTION: openssl rand -base64 64
# Container/orchestrated deployments should mount secrets as files instead:
# JWT_SECRET_FILE=/run/secrets/actae_jwt
# API-key hashing secret — defaults to JWT_SECRET for backward compat.
# API_KEY_HASH_SECRET=another-long-random-secret-at-least-32-chars
# API_KEY_HASH_SECRET_FILE=/run/secrets/actae_api_key_hash
# Password signup/login is opt-in — the SaaS-issued API key is the primary
# credential. Set to true only for offline/admin deployments.
ENABLE_SIGNUP=false

# API keys — provision production keys via the portal (`actae enroll <key>`
# or `ACTAE_ENROLL_KEY`), the control plane, or locally with
# `actae keys create`. The first-boot seed below makes local/dev instances
# deterministic (the well-known dev key the SDK tests expect). Omit it on a
# standalone first boot and Actae auto-generates a key printed once.
# ACTAE_ENROLL_KEY=sk-...
# ACTAE_ENROLL_KEY_FILE=/run/secrets/actae_enroll_key
ACTAE_INITIAL_API_KEY=sk-dev-0000000000000000000000

# SDK client credentials. On the boot that mints/seeds a key, a standalone
# instance also writes the endpoint + key to <ACTAE_CONFIG_DIR>/client.json
# (0600) so the Python/Go/TS SDKs authenticate with no configuration. Set to 0
# to keep a plaintext key off disk (the banner still prints it). Manage the file
# with `actae login` / `actae logout`. See docs/CLIENT_CREDENTIALS.md.
# ACTAE_WRITE_CLIENT_CREDENTIALS=1
# ACTAE_CONFIG_DIR=~/.actae

# Local dashboard auto-login. A standalone instance served to a same-machine
# browser (loopback peer + Host + Origin) gets an admin session with no
# login/setup form, so a local self-host needs no account. Set to 0 to require a
# sign-in even locally. Remote/LAN access always requires a sign-in. See
# docs/SELF_HOSTED_AUTH.md.
# ACTAE_LOCAL_AUTO_LOGIN=1

# Embedded PostgreSQL (--embedded / ACTAE_EMBEDDED=1). The server manages a
# real PostgreSQL child (scram auth, loopback TCP only, auto-bumping ports)
# with binaries embedded in the binary (release builds — never downloaded,
# SHA-256 pinned in actae/pg-checksums.json), downloaded once (dev builds),
# or from ACTAE_PG_BIN_DIR (a zonky tree root with bin/ + lib/ + share/).
# ACTAE_DATA_DIR=~/.actae/data
# ACTAE_EMBEDDED_PG_PORT=5546
# ACTAE_EMBEDDED_PG_PASSWORD=  # auto-generated; printed once on the boot that mints it;
#                              # the persisted pg.pwfile is authoritative afterwards
# ACTAE_EMBEDDED_PG_WIPE=0
# ACTAE_AUTO_BUMP=1           # 0 = fail if the base port is busy
# ACTAE_PG_NO_HOST=0          # 1 = never adopt a host-installed PostgreSQL (force the download)

# External PostgreSQL TLS. `prefer`/`allow` are rejected because they permit
# downgrade. `require`, `verify-ca`, and `verify-full` all verify the server
# certificate and hostname; add the private CA path when it is not public.
# POSTGRES_SSL_MODE=verify-full
# POSTGRES_SSL_ROOT_CERT=/run/secrets/postgres-ca.pem
# CLIENT_POSTGRES_SSL_MODE=verify-full
# CLIENT_POSTGRES_SSL_ROOT_CERT=/run/secrets/postgres-ca.pem

# Event retention
EVENT_RETENTION_DAYS=30
RETENTION_CHECK_INTERVAL_SECS=3600
# 0 = unlimited. Hosted plans set these explicitly and atomically reject a
# write with HTTP 429 when ANY allowance is exhausted (see
# docs/STORAGE_ACCOUNTING.md). "Data written" = event payload + metadata +
# saved state + tool results accepted during the month; "retained data" = the
# current logical payload stored (state versions + fork copies included).
# EVENT_MAX_EVENTS_PER_MONTH=0
# EVENT_MAX_INGRESS_BYTES_PER_MONTH=0   # legacy alias, still enforced as a
#                                       # separate hard cap alongside the above
# EVENT_MAX_DURABLE_WRITTEN_BYTES_PER_MONTH=0
# EVENT_MAX_RETAINED_BYTES=0
# STATE_RETENTION_DAYS=0
# TOOL_EXECUTION_RETENTION_DAYS=0

# WebSocket
WS_MAX_CONNECTIONS=10000
WS_MAX_MESSAGE_SIZE=1048576
WS_PING_INTERVAL_SECONDS=30

# Performance
ENABLE_COMPRESSION=true
MESSAGE_BATCH_SIZE=100
MESSAGE_BATCH_TIMEOUT_MS=10

# Features
ENABLE_METRICS=true
ENABLE_ANONYMOUS=false

# SaaS control plane (saas/backend; separate process). Production uses
# PostgreSQL; SQLite remains a local-test fallback only.
# SAAS_DATABASE_URL=postgresql://actae_saas@127.0.0.1:5432/actae_saas?sslmode=disable
# PGPASSFILE=/var/lib/actae-saas/.pgpass
# SAAS_DB_POOL_MIN=1
# SAAS_DB_POOL_MAX=5
# SAAS_POLAR_ACCESS_TOKEN=polar_...
# SAAS_POLAR_BASE_URL=https://sandbox-api.polar.sh
# SAAS_POLAR_WEBHOOK_SECRET=...
# Plans SOLD today: the three Cloud tiers, each a per-installation Polar
# product (Developer $49 / Team $149 / Scale $499, Polar-managed 30-day
# card-backed trial) bought via POST /api/portal/tier-checkout. Self-hosted is
# FREE (the anonymous community download) and is never sold as a subscription.
# Configure only the products you sell; each product's metadata must set
# actae_plan_code. The storage caps per plan are set server-side via the
# EVENT_MAX_*/STATE_RETENTION_DAYS/TOOL_EXECUTION_RETENTION_DAYS vars above (see
# docs/STORAGE_ACCOUNTING.md).
# SAAS_POLAR_PRODUCT_DEVELOPER=...
# SAAS_POLAR_PRODUCT_TEAM=...
# SAAS_POLAR_PRODUCT_SCALE=...
# Legacy/grandfathered ONLY — these retired codes are no longer sold or
# advertised. Keep them configured iff you must keep fulfilling existing
# subscriptions (webhooks + hourly reconciliation still resolve them); omit
# them otherwise.
# SAAS_POLAR_PRODUCT_CLOUD_FOUNDING=...
# SAAS_POLAR_PRODUCT_SELF_HOSTED_FOUNDING=...
# SAAS_POLAR_PRODUCT_FOUNDING_TEAM=...
# SAAS_POLAR_PRODUCT_SELF_HOSTED_TEAM=...
# SAAS_POLAR_CHECKOUT_SUCCESS_URL=https://actae.dev/app?checkout=success&checkout_id={CHECKOUT_ID}
# SAAS_POLAR_CHECKOUT_RETURN_URL=https://actae.dev/app/settings/
# SAAS_POLAR_PAST_DUE_GRACE_DAYS=3
# Required by a production frontend build (pricing is always shown, and the
# legal identity appears in Terms/Privacy/refunds and checkout copy):
# NEXT_PUBLIC_LEGAL_ENTITY_NAME=...
# NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=...
# NEXT_PUBLIC_LEGAL_JURISDICTION=...
# NEXT_PUBLIC_LEGAL_REGISTRATION_NUMBER=...
# SAAS_ALERT_WEBHOOK_URL=https://monitored-alert-destination.example/...
